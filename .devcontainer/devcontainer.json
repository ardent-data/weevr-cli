{
    "name": "weevr-cli",

    "image": "mcr.microsoft.com/devcontainers/python:3.11",

    // Rootless podman maps the host user to container root by default, so the
    // workspace bind mount appears owned by root and vscode (UID 1000) can only
    // write where "other" has write permission. keep-id maps the host UID
    // straight through, so the workspace is owned by vscode.
    "runArgs": [
        "--userns=keep-id"
    ],

    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/copilot-cli:1": {},
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
        "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},
        "ghcr.io/jsburckhardt/devcontainer-features/codex:1": {},
        "ghcr.io/devcontainers-extra/features/actionlint:1": {},
        "ghcr.io/devcontainers-extra/features/shellcheck:1": {}
    },

    "mounts": [
        "source=weevr-cli-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
        "source=weevr-cli-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
        "source=weevr-cli-codex-${devcontainerId},target=/home/vscode/.codex,type=volume"
    ],

    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },

    "postCreateCommand": {
        "safe-dir": "git config --global --add safe.directory /workspaces/weevr-cli",
        "volumes": "sudo chown -R vscode:vscode /home/vscode/.config/gh /home/vscode/.claude /home/vscode/.codex",
        "gtr": "git clone https://github.com/coderabbitai/git-worktree-runner.git /home/vscode/.gtr && sudo ln -sf /home/vscode/.gtr/bin/git-gtr /usr/local/bin/git-gtr && sudo ln -sf /home/vscode/.gtr/bin/gtr /usr/local/bin/gtr",
        "deps": "uv sync --dev"
    },

    "postStartCommand": "uv sync",

    "remoteEnv": {
        "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
        "UV_PYTHON_PREFERENCE": "system"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-pyright.pyright",
                "charliermarsh.ruff",
                "the0807.uv-toolkit",
                "redhat.vscode-yaml",
                "tamasfe.even-better-toml",
                "EditorConfig.EditorConfig",
                "github.vscode-pull-request-github",
                "github.vscode-github-actions",
                "davidanson.vscode-markdownlint",
                "streetsidesoftware.code-spell-checker"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
                "editor.rulers": [100],
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                }
            }
        }
    },

    "remoteUser": "vscode"
}
